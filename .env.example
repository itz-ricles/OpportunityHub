# Copy this file to .env and fill in real values. NEVER commit .env.

# development | production | testing. If missing, the app runs as PRODUCTION (safe default).
# Keep "development" on your own computer so debug mode and plain-HTTP cookies work.
FLASK_ENV=development

# Required. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Local database file (SQLite). Used when DATABASE_URL is empty.
DATABASE_PATH=database/opportunityhub.db

# Production database (PostgreSQL / Amazon RDS). Leave empty locally.
# Special characters in the password must be URL-encoded (@ becomes %40).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Production only
# FORCE_HTTPS=true            # set false ONLY for a short HTTP-only demo with no real passwords
# TRUSTED_PROXY_COUNT=0       # number of proxies in front of the app (see aws_deployment_guide.md)
# LOG_LEVEL=INFO
